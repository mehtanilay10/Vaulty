generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StorageProvider {
  GOOGLE_DRIVE
}

enum StorageConnectionStatus {
  CONNECTED
  SYNCING
  SYNCED
  PENDING
  FAILED
  DISCONNECTED
  RECONNECT_REQUIRED
}

enum DocumentStorageStatus {
  ACTIVE
  DELETED_EXTERNALLY
  PENDING
  FAILED
  CONFLICT
}

enum SyncEventStatus {
  SUCCESS
  FAILED
  PENDING
}

enum SyncEventOperation {
  UPLOAD
  DOWNLOAD
  UPDATE
  RENAME
  MOVE
  DELETE
  IMPORT
  CONFLICT
}

model User {
  id                   String        @id @default(cuid())
  name                 String?
  email                String?       @unique
  emailVerified        DateTime?
  image                String?
  defaultStorageProvider StorageProvider @default(GOOGLE_DRIVE)
  sessionVersion       Int           @default(0)
  reminderEmailsEnabled Boolean     @default(true)
  reminderInAppEnabled Boolean      @default(true)
  pushNotificationsEnabled Boolean @default(false)
  accounts             Account[]
  sessions             Session[]
  folders              Folder[]      @relation("UserFolders")
  documents            Document[]    @relation("UserDocuments")
  folderSharesReceived FolderShare[] @relation("SharedWithUser")
  folderSharesCreated  FolderShare[] @relation("SharedByUser")
  storageConnections   StorageConnection[]
  auditLogs            AuditLog[]
  syncEvents           SyncEvent[]
  chatSessions         ChatSession[]
  wealthAccounts       WealthAccount[] @relation("UserWealthAccounts")
  gmailConnection      GmailConnection?
  outlookConnection    OutlookConnection?
  emailTransactionImports EmailTransactionImport[]
  emailDocumentImports  EmailDocumentImport[]
  emailReminderImports  EmailReminderImport[]
  passwordVault        PasswordVault?
  vaultSharesReceived  VaultShare[] @relation("VaultSharedWithUser")
  vaultSharesCreated   VaultShare[] @relation("VaultSharedByUser")
  notifications        Notification[]
  reminders            Reminder[]
  pushSubscriptions    PushSubscription[]
  pdfPasswordSettings  PdfPasswordSettings?
  inboundEmailToken      String?  @unique @default(cuid()) @db.VarChar(64)
  inboundEmailSlug       String?  @unique @db.VarChar(64)
  inboundEmailEnabled    Boolean  @default(true)
  inboundAllowedSenders  String[] @default([])
  inboundAttachments    InboundEmailAttachment[]
  familyInvitationsSent FamilyInvitation[] @relation("FamilyInvitationsSent")
  familyMembershipsOwned FamilyMembership[] @relation("FamilyMembershipsOwned")
  familyMembershipsJoined FamilyMembership[] @relation("FamilyMembershipsJoined")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  parentId  String?
  storageProvider StorageProvider @default(GOOGLE_DRIVE)
  storageFolderId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User          @relation("UserFolders", fields: [ownerId], references: [id], onDelete: Cascade)
  parent   Folder?       @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[]      @relation("FolderHierarchy")
  documents Document[]
  shares   FolderShare[]

  @@index([ownerId])
  @@index([parentId])
  @@index([storageFolderId])
}

model Document {
  id        String   @id @default(cuid())
  name      String
  thumbnailUrl String?
  mimeType  String
  sizeBytes Int
  folderId  String
  ownerId   String
  storageProvider StorageProvider @default(GOOGLE_DRIVE)
  storageFileId String?
  storageParentId String?
  storageModifiedAt DateTime?
  storageChecksum String?
  storageVersion String?
  storageWebViewLink String?
  storageStatus DocumentStorageStatus @default(ACTIVE)
  googleDriveSummaryFileId String?
  googleDriveTextFileId String?
  googleDriveInterpretationFileId String?
  expiryDate DateTime?
  lastOpenedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User          @relation("UserDocuments", fields: [ownerId], references: [id], onDelete: Cascade)
  folder       Folder        @relation(fields: [folderId], references: [id], onDelete: Cascade)
  tags         DocumentTag[]
  aiProcessing AiProcessing?
  aiJobs       AiJob[]       @relation("DocumentAiJobs")
  auditLogs    AuditLog[]
  syncEvents   SyncEvent[]
  shareLinks   ShareLink[]

  @@index([ownerId])
  @@index([folderId])
  @@index([storageFileId])
  @@index([ownerId, lastOpenedAt])
  @@index([ownerId, expiryDate])
  @@index([expiryDate])
}

model ShareLink {
  id         String   @id @default(cuid())
  documentId String
  token      String   @unique
  password   String?
  expiresAt  DateTime?
  maxViews   Int?
  viewCount  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  createdBy  String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([documentId])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  documents DocumentTag[]
  createdAt DateTime      @default(now())
}

model DocumentTag {
  documentId String
  tagId      String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([tagId])
}

model FolderShare {
  id               String   @id @default(cuid())
  folderId         String
  sharedWithUserId String
  createdById      String
  permission       String   @default("READ_ONLY")
  createdAt        DateTime @default(now())

  folder     Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  sharedWith User   @relation("SharedWithUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  createdBy  User   @relation("SharedByUser", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([folderId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([folderId])
}

enum AiStatus {
  NOT_REQUESTED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum AiJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum WealthAccountType {
  SAVINGS_ACCOUNT
  CURRENT_ACCOUNT
  CREDIT_CARD
  MUTUAL_FUND
  STOCK_PORTFOLIO
  LOAN
  PPF
  PF
  GIFT_CARD
  VOUCHER
  FIXED_DEPOSIT
  RECURRING_DEPOSIT
  CASH
  OTHER
}

enum WealthAccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
  FROZEN
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PURCHASE
  SALE
  INTEREST
  DIVIDEND
  FEE
  PAYMENT
  REFUND
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

model AiProcessing {
  id                     String    @id @default(cuid())
  documentId             String    @unique
  status                 AiStatus  @default(NOT_REQUESTED)
  extractedText          String?   @db.Text
  summaryMarkdown        String?   @db.Text
  interpretationMarkdown String?   @db.Text
  extractedMetadata      Json?
  errorMessage           String?   @db.Text
  modelUsed              String?
  processedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model AiJob {
  id              String      @id @default(cuid())
  documentId      String
  status          AiJobStatus @default(QUEUED)

  attempts        Int         @default(0)
  maxAttempts     Int         @default(5)

  availableAt     DateTime    @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?

  lockedAt        DateTime?
  lockedBy        String?

  lastHeartbeatAt DateTime?

  lastError       String?     @db.Text
  errorCode       String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  document Document @relation("DocumentAiJobs", fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([documentId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  userId     String
  documentId String?
  folderId   String?
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
}

model StorageConnection {
  id                  String                  @id @default(cuid())
  userId              String
  provider            StorageProvider         @default(GOOGLE_DRIVE)
  status              StorageConnectionStatus @default(DISCONNECTED)
  rootFolderId        String?
  docsFolderId        String?
  summaryFolderId     String?
  textFolderId        String?
  interpretationFolderId String?
  accessToken         String?                 @db.Text
  refreshToken        String?                 @db.Text
  expiresAt           DateTime?
  pageToken           String?
  channelId           String?
  channelResourceId   String?
  channelExpiration   DateTime?
  lastSyncedAt        DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncEvents SyncEvent[] @relation("ConnectionSyncEvents")

  @@unique([userId, provider])
  @@index([userId])
}

model SyncEvent {
  id          String            @id @default(cuid())
  userId      String
  provider    StorageProvider   @default(GOOGLE_DRIVE)
  documentId  String?
  folderId    String?
  operation   SyncEventOperation
  status      SyncEventStatus   @default(PENDING)
  errorCode   String?
  errorMessage String?          @db.Text
  metadata    String?           @db.Text
  createdAt   DateTime          @default(now())
  completedAt DateTime?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    Document?         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  connection  StorageConnection? @relation("ConnectionSyncEvents", fields: [connectionId], references: [id], onDelete: SetNull)
  connectionId String?

  @@index([userId])
  @@index([userId, status])
  @@index([documentId])
  @@index([createdAt])
}

model ChatSession {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  sessionId      String
  role           String
  content        String   @db.Text
  referencedDocs String?
  createdAt      DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@index([sessionId, createdAt])
}

model WealthAccount {
  id          String              @id @default(cuid())
  ownerId     String
  name        String
  type        WealthAccountType
  status      WealthAccountStatus @default(ACTIVE)

  accountNumber   String?
  bankName        String?
  branchName      String?

  currentBalance  Decimal    @db.Decimal(18, 2)
  currency        String     @default("INR")

  creditLimit     Decimal?   @db.Decimal(18, 2)
  billingCycle    String?
  dueDate         Int?

  isin            String?
  broker          String?
  dematAccount    String?

  loanType        String?
  interestRate    Decimal?   @db.Decimal(5, 2)
  emiAmount       Decimal?   @db.Decimal(18, 2)
  tenureMonths    Int?
  startDate       DateTime?
  endDate         DateTime?

  provider        String?
  expiryDate      DateTime?
  pin             String?

  notes           String?    @db.Text
  category        String?
  tags            String[]

  paymentNotifyDaysBefore Int[]   @default([7, 3, 1, 0])
  expiryNotifyDaysBefore  Int[]   @default([30, 7, 1, 0])

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  owner           User       @relation("UserWealthAccounts", fields: [ownerId], references: [id], onDelete: Cascade)
  transactions    WealthTransaction[]
  emailTransactionImports EmailTransactionImport[]

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([type])
  @@index([status])
}

model WealthTransaction {
  id              String          @id @default(cuid())
  accountId       String
  type            TransactionType
  amount          Decimal         @db.Decimal(18, 2)
  currency        String          @default("INR")

  description     String
  referenceNumber String?
  date            DateTime        @default(now())

  balanceAfter    Decimal         @db.Decimal(18, 2)

  category        String?
  subcategory     String?

  units           Decimal?        @db.Decimal(18, 4)
  navPrice        Decimal?        @db.Decimal(18, 4)

  notes           String?         @db.Text
  attachments     String[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  account         WealthAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, date])
  @@index([date])
  @@index([type])
}

enum CredentialType {
  APP
  BANK
}


enum GmailConnectionStatus {
  CONNECTED
  RECONNECT_REQUIRED
  DISCONNECTED
}

enum EmailTransactionImportStatus {
  PENDING
  IMPORTED
  DISMISSED
}

model GmailConnection {
  id                    String               @id @default(cuid())
  ownerId               String               @unique
  emailAddress          String
  refreshTokenEncrypted String               @db.Text
  status                GmailConnectionStatus @default(CONNECTED)
  lastSyncedAt          DateTime?
  syncPageToken         String?              @db.Text
  syncLookbackDays      Int?
  connectedAt           DateTime             @default(now())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([status])
}

model OutlookConnection {
  id                    String                @id @default(cuid())
  ownerId               String                @unique
  emailAddress          String
  refreshTokenEncrypted String                @db.Text
  status                GmailConnectionStatus @default(CONNECTED)
  lastSyncedAt          DateTime?
  syncPageToken         String?               @db.Text
  connectedAt           DateTime              @default(now())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([status])
}

model EmailTransactionImport {
  id              String                        @id @default(cuid())
  ownerId         String
  emailMessageId  String
  threadId        String?
  fromAddress     String                        @db.VarChar(320)
  subject         String?                       @db.VarChar(500)
  bankName        String?                       @db.VarChar(120)
  merchant        String?                       @db.VarChar(180)
  description     String                        @db.VarChar(240)
  amount          Decimal                       @db.Decimal(18, 2)
  currency        String                        @default("INR") @db.VarChar(3)
  type            TransactionType
  referenceNumber String?                       @db.VarChar(80)
  date            DateTime
  accountId       String?
  status          EmailTransactionImportStatus  @default(PENDING)
  sourceProvider  String                        @default("GMAIL") @db.VarChar(16)
  aiConfidence    Float?
  aiReason        String?                       @db.Text
  aiClassifiedAt  DateTime?
  importedAt      DateTime?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  account WealthAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([ownerId, emailMessageId])
  @@index([ownerId, status, date])
  @@index([ownerId, sourceProvider, status, date])
  @@index([ownerId, createdAt])
  @@index([accountId])
}

model EmailDocumentImport {
  id                 String                        @id @default(cuid())
  ownerId            String
  emailMessageId     String
  sourceProvider     String                        @default("GMAIL") @db.VarChar(16)
  fromAddress        String                        @db.VarChar(320)
  subject            String?                       @db.VarChar(500)
  receivedAt         DateTime
  documentTitle      String                        @db.VarChar(240)
  documentType       String                        @default("OTHER") @db.VarChar(80)
  filename           String?                       @db.VarChar(255)
  mimeType           String?                       @db.VarChar(128)
  fileSizeBytes      Int?                          @default(0)
  attachmentId       String?                       @db.VarChar(255)
  extractedSummary   String?                       @db.Text
  expiryDate         DateTime?
  aiConfidence       Float?
  aiReason           String?                       @db.Text
  status             EmailTransactionImportStatus  @default(PENDING)
  importedDocumentId String?
  importedAt         DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, emailMessageId])
  @@index([ownerId, status, receivedAt])
  @@index([ownerId, sourceProvider, status])
  @@index([ownerId, createdAt])
}

model EmailReminderImport {
  id                 String                        @id @default(cuid())
  ownerId            String
  emailMessageId     String
  sourceProvider     String                        @default("GMAIL") @db.VarChar(16)
  fromAddress        String                        @db.VarChar(320)
  subject            String?                       @db.VarChar(500)
  receivedAt         DateTime
  title              String                        @db.VarChar(240)
  description        String?                       @db.Text
  category           ReminderCategory              @default(PERSONAL)
  dueAt              DateTime
  amount             Decimal?                      @db.Decimal(18, 2)
  currency           String?                       @default("INR") @db.VarChar(3)
  aiConfidence       Float?
  aiReason           String?                       @db.Text
  status             EmailTransactionImportStatus  @default(PENDING)
  importedReminderId String?
  importedAt         DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, emailMessageId])
  @@index([ownerId, status, dueAt])
  @@index([ownerId, sourceProvider, status])
  @@index([ownerId, createdAt])
}

model InboundEmailAttachment {
  id             String   @id @default(cuid())
  userId         String
  emailMessageId String   @db.VarChar(255)
  filename       String   @db.VarChar(255)
  mimeType       String   @db.VarChar(128)
  sizeBytes      Int
  data           Bytes
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, emailMessageId])
  @@index([createdAt])
}

model PasswordVault {
  id                String   @id @default(cuid())
  userId            String   @unique
  masterPasswordHash String? @db.Text
  encryptionSalt    String?  @db.Text
  isConfigured      Boolean  @default(false)
  kdfIterations     Int      @default(100000)
  resetToken        String?  @unique
  resetTokenExpires DateTime?
  failedAttempts    Int      @default(0)
  lockedUntil       DateTime?

  // Encryption key recovery: recovery key (offline) encrypts the KEK so users
  // can recover credentials if they forget their master password.
  recoveryKeyId          String?   @unique
  recoveryKeyHash        String?   @db.Text
  recoveryEncryptedKEK   String?   @db.Text
  recoverySalt           String?   @db.Text
  recoveryIv             String?   @db.Text
  recoveryKdfIterations  Int       @default(100000)
  recoveryQuestions      String?   @db.Text

  // Family sharing key material. The private key is always encrypted
  // client-side with the vault KEK; the server only stores ciphertext.
  familyPublicKey           String?   @db.Text
  familyEncryptedPrivateKey String?   @db.Text
  familyPrivateKeyIv        String?   @db.Text
  familyKeyUpdatedAt        DateTime?

  // Cross-device App Lock & convenient vault unlock
  appLockPinHash            String?   @db.Text
  appLockWrappedKey         String?   @db.Text

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appCredentials    AppCredential[]
  bankCredentials   BankCredential[]
  vaultShares       VaultShare[]
  auditLogs         PasswordAuditLog[]

  @@index([userId])
  @@index([resetToken])
}

model AppCredential {
  id                String   @id @default(cuid())
  vaultId           String
  name              String   @db.Text
  url               String?  @db.Text
  username          String   @db.Text
  password          String   @db.Text
  isFavorite        Boolean  @default(false)
  lastAccessedAt    DateTime?
  icon              String?
  iconColor         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vault             PasswordVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([vaultId])
  @@index([isFavorite])
  @@index([vaultId, isFavorite])
}

model BankCredential {
  id                    String   @id @default(cuid())
  vaultId               String
  name                  String   @db.Text
  username              String   @db.Text
  netbankPassword       String?  @db.Text
  atmPin                String?  @db.Text
  upiPin                String?  @db.Text
  mobileAppPin          String?  @db.Text
  mobileTransactionPin String?  @db.Text
  isFavorite            Boolean  @default(false)
  lastAccessedAt        DateTime?
  icon                  String?
  iconColor             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  vault                 PasswordVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([vaultId])
  @@index([isFavorite])
  @@index([vaultId, isFavorite])
}

model VaultShare {
  id           String   @id @default(cuid())
  vaultId      String
  sharedWithId String
  sharedById   String
  permission   String   @default("READ_ONLY")
  createdAt    DateTime @default(now())

  vault        PasswordVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  sharedWith   User          @relation("VaultSharedWithUser", fields: [sharedWithId], references: [id], onDelete: Cascade)
  sharedBy     User          @relation("VaultSharedByUser", fields: [sharedById], references: [id], onDelete: Cascade)

  @@unique([vaultId, sharedWithId])
  @@index([vaultId])
  @@index([sharedWithId])
}

model PasswordAuditLog {
  id           String   @id @default(cuid())
  vaultId      String
  action       String
  credentialType String?
  credentialId String?
  metadata     String?  @db.Text
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  vault        PasswordVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([vaultId])
  @@index([createdAt])
  @@index([credentialId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String   @db.Text
  metadata  String?  @db.Text
  actionUrl String?
  idempotencyKey String? @unique
  read      Boolean  @default(false)
  emailSentAt DateTime?
  emailLastError String? @db.Text
  pushSentAt DateTime?
  pushLastError String? @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

enum FamilyInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

model FamilyInvitation {
  id               String                 @id @default(cuid())
  ownerId          String
  email            String
  token            String                 @unique
  status           FamilyInvitationStatus @default(PENDING)
  shareDocuments   Boolean                @default(false)
  shareWealth      Boolean                @default(false)
  shareCredentials Boolean                @default(false)
  shareReminders   Boolean                @default(false)
  expiresAt        DateTime
  respondedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  owner User @relation("FamilyInvitationsSent", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, email])
  @@index([ownerId])
  @@index([email])
  @@index([status])
}

model FamilyMembership {
  id               String   @id @default(cuid())
  ownerId          String
  memberId         String
  shareDocuments   Boolean  @default(false)
  shareWealth      Boolean  @default(false)
  shareCredentials Boolean  @default(false)
  shareReminders   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner         User                 @relation("FamilyMembershipsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  member        User                 @relation("FamilyMembershipsJoined", fields: [memberId], references: [id], onDelete: Cascade)
  credentialKey FamilyCredentialKey?

  @@unique([ownerId, memberId])
  @@index([ownerId])
  @@index([memberId])
}

model FamilyCredentialKey {
  id           String   @id @default(cuid())
  membershipId String   @unique
  ownerId      String
  memberId     String
  wrappedKey   String   @db.Text
  keyVersion   Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership FamilyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([memberId])
}


model SecurityRateLimit {
  key             String   @id
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt

  @@index([blockedUntil])
}


enum ReminderCategory {
  DOCUMENT
  PAYMENT
  INSURANCE
  SUBSCRIPTION
  PERSONAL
}

enum ReminderRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Reminder {
  id             String             @id @default(cuid())
  userId         String
  title          String
  description    String?            @db.Text
  category       ReminderCategory   @default(PERSONAL)
  dueAt          DateTime
  recurrence     ReminderRecurrence @default(NONE)
  notifyDaysBefore Int[]            @default([7, 1, 0])
  notifyInApp    Boolean            @default(true)
  notifyByEmail  Boolean            @default(true)
  isCompleted    Boolean            @default(false)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt, isActive])
  @@index([userId, isCompleted])
  @@index([isActive, isCompleted, dueAt])
}


model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique @db.Text
  p256dh     String   @db.Text
  auth       String   @db.Text
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model PdfPasswordSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  encryptedConfig String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
