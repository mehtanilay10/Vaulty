{
  "name": "vaulty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "build:fast": "prisma generate && cross-env FAST_BUILD=true NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ai:worker": "tsx src/workers/ai-worker.ts",
    "worker:email": "tsx src/workers/email-worker.ts",
    "emails:download": "tsx scripts/download-emails.ts",
    "emails:identify-senders": "tsx scripts/identify-bank-senders.ts",
    "emails:process": "tsx scripts/process-emails-local.ts",
    "emails:reset": "tsx scripts/reset-emails-and-wealth.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "vercel-build": "prisma generate && prisma migrate deploy && cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "prepare": "husky",
    "prettier:fix": "prettier --write .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@google/genai": "^3.6.1",
    "@prisma/client": "^6.3.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/markdown": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "fflate": "^0.8.3",
    "googleapis": "^190.0.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.37.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^4.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prisma": "^6.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "resolutions": {
    "deepmerge-ts": "^8.0.2",
    "@typescript-eslint/typescript-estree/minimatch": "^11.0.9",
    "effect": "^3.22.1"
  },
  "packageManager": "yarn@4.5.3"
}
