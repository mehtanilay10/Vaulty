# Database
DATABASE_URL="postgresql://user:password@host:5432/neondb?sslmode=require"

# Authentication (Google OAuth)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
AUTH_SECRET="your-nextauth-secret-key"
CSRF_SECRET="generate-a-separate-random-secret-at-least-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# Authentication (Email Magic Links via Resend)
RESEND_API_KEY="re_your-resend-api-key"
RESEND_INBOUND_WEBHOOK_SECRET="whsec_your-resend-webhook-signing-secret"
INBOUND_EMAIL_DOMAIN="vaulty.mnilay.com"
EMAIL_FROM="noreply@yourdomain.com"

# Google Gemini API (Multi-Key support: rotates across keys with 30s cooldown on rate limit)
GEMINI_API_KEY_1="your-gemini-api-key-1"
GEMINI_API_KEY_2="your-gemini-api-key-2"
GEMINI_API_KEY_3="your-gemini-api-key-3"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# Application Settings
MAX_UPLOAD_SIZE="52428800"

# Cron / Worker
CRON_SECRET="your-random-cron-secret-here-at-least-32-chars"

# Outlook personal Microsoft account email sync
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="consumers"

# Browser push notifications (generate a P-256 key pair; see README.md)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
WEB_PUSH_SUBJECT="mailto:admin@yourdomain.com"

# Optional dedicated 32+ character key for encrypting reusable PDF statement password settings.
# Falls back to AUTH_SECRET when omitted; set explicitly for key separation.
PDF_PASSWORD_SETTINGS_SECRET="your-pdf-password-settings-secret-key"

# Google Drive Webhook Security (required for drive push change notifications; min 32 chars)
GOOGLE_DRIVE_WEBHOOK_SECRET="generate-a-separate-webhook-secret-at-least-32-characters"

# Administrative Access (comma-separated list of emails permitted to access /api/admin/*)
ADMIN_EMAILS="admin@yourdomain.com"

# Local Development Bypass (used only when NODE_ENV=development for /api/dev-login)
DEV_LOGIN_EMAIL="user@example.com"

# Background AI & Email Workers (optional tuning overrides)
AI_WORKER_BATCH_SIZE="2"
AI_WORKER_BATCH_INTERVAL_MS="180000"
AI_WORKER_ID="worker-1"
EMAIL_WORKER_POLL_INTERVAL_MS="300000"
